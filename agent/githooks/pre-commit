#!/usr/bin/env bash
# ТЗ-34 F6: красный selfcheck нельзя закоммитить, как бы его ни звали.
# Регрессия 6c1ba21: `bash agent/selfcheck.sh | tail -1` вернул код
# tail, и красный коммит уехал. Хук зовёт селфчек БЕЗ пайпа и падает
# вместе с ним. Активируется раз на клон:
#   git config core.hooksPath agent/githooks
# (см. agent/PROTOCOL.md §12 — строка бутстрапа).

# I5_NESTED: вложенный прогон приёмки пропускает сами тесты I5
# (иначе тест I5 мутирует индекс под коммитом)
I5_NESTED=1 bash "$(dirname "$0")/../selfcheck.sh"
